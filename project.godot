; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/version="0.9.8.1"

config/name="MCF Isotope"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Ui="*res://src/ui/UiTheme.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
; Без этой строки Godot берёт aspect="keep": холст 1280x720 вписывается в окно целиком, и
; на любом не-16:9 экране по краям остаются чёрные поля, а привязанные к краю панели (HUD
; боя, палитра редактора) встают не у края окна. На ноутбуках 16:10 и ультравайдах - то
; есть у доброй половины игроков на Windows - это и читается как "интерфейс съехал".
; "expand" вместо полей растит вьюпорт: масштаб прежний, просто видно больше поля.
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
; Чёрный фон окна по умолчанию (item 5). Годотовский серый (~0.3) просвечивал везде,
; где параллакс/сцена не закрашивали кадр целиком — отсюда «параллакс серый, не чёрный».
;
; Комментарии здесь ОБЯЗАНЫ начинаться с ';'. С '#' строка ниже не читалась вовсе, и
; настройка молча не применялась: игра все эти месяцы шла с годотовским серым фоном
; (проверено ProjectSettings.get_setting в 0.9.3). В [debug] ниже комментарии правильные —
; поэтому отключение file_logging работало, а это нет.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[debug]

; Godot mirrors stdout into app_userdata/.../logs/godot.log. For the RL env servers that
; stdout IS the JSON protocol, so every response was being written twice - once to the
; trainer, once to a log nobody reads. Overnight it reached 6.5 GB in one file and 7.4 GB
; in the directory, consuming ~1.4 GB/hr and very nearly stopping training on a full disk.
; The trainer keeps its own logs under rl/runs/, so nothing is lost by turning this off.
file_logging/enable_file_logging=false

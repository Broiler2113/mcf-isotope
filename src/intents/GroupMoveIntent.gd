class_name GroupMoveIntent
extends Intent

## Приказ движения выделенной группе (#18, item 34).
##
## Клетку каждому юниту выбирает жадный распределитель на машине того, кто отдал
## приказ, и по проводу едет уже ГОТОВЫЙ список «кому куда». Это и есть причина,
## по которой групповое выделение было выключено в сети: раньше приказ раздавался
## как N отдельных движений, посчитанных локально по живой сетке, — распределение
## получалось у каждого пира своё, и доски расходились.
##
## Список явный ещё и потому, что он ровно тот, который игрок УВИДЕЛ в предпросмотре
## (§18.3): распределитель прогоняется один раз, а не пересчитывается при исполнении.

var unit_ids: Array[int] = []
var targets: Array[Vector2i] = []

func _init(p_unit_ids: Array[int] = [], p_targets: Array[Vector2i] = []) -> void:
	# actor_id группового приказа — первый юнит: по нему резолвер и боевой экран
	# находят, чей это ход, теми же средствами, что и для одиночного намерения.
	super(p_unit_ids[0] if not p_unit_ids.is_empty() else -1)
	unit_ids = p_unit_ids.duplicate()
	targets = p_targets.duplicate()

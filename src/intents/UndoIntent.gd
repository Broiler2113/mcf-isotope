class_name UndoIntent
extends Intent

## Откат последнего действия (§18.2, item 28).
##
## Откат — это НАМЕРЕНИЕ, а не кнопка боевого экрана. Раньше он жил целиком в
## Main.gd и в сетевой партии не работал вовсе: _on_intent_ready уходил в сеть
## раньше, чем клал снимок, и стек всегда оставался пустым. Проведённый через
## резолвер, откат едет по обычному лок-степу — оба пира снимают ОДИН И ТОТ ЖЕ
## снимок со своих одинаковых стеков и приходят к одной доске.

## Кто просит откат. Резолвер откажет, если это не текущая сторона.
var requester: int = -1

func _init(p_requester: int = -1) -> void:
	super(-1)
	requester = p_requester

class_name MoveHeldIntent
extends Intent

## Переставить УЖЕ удерживаемого пленника на другую соседнюю с носильщиком клетку (#100).
## Бесплатно: ОД и очки движения не тратятся — носильщик просто перехватывает тело
## с одной руки на другую, не сходя с места. Само правило «раз за раунд» (§3.4)
## этим не нарушается: оно ограничивает НОВЫЕ захваты, а не перекладывание своего груза.

var to: Vector2i

func _init(p_actor_id: int, p_to: Vector2i) -> void:
	super(p_actor_id)
	to = p_to

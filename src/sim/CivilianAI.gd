class_name CivilianAI
extends RefCounted

## Кто такой мирный житель (§3.10). Только ОПОЗНАНИЕ, без поведения.
##
## Мирные — третья сторона (owner == MCF.Owner.NEUTRAL). Они ПАССИВНЫ, пока их не
## «вскрыли» (UnitInstance.civilian_active). Триггеров ровно два, и защёлкиваются они
## в резолвере: где-либо на карте начался бой, ЛИБО житель сам видит солдата по
## чистой линии огня. Обратно житель уже не успокаивается.
##
## Вскрытый житель ОХОТИТСЯ (#79): идёт к ближайшему солдату, до которого может
## добраться, и стреляет по нему. Солдатами считаются обе игровые стороны — мирные
## враждебны всем, но НЕ друг другу.
##
## РЕШАЕТ за жителя не этот модуль, а AIController (#103). Здесь когда-то жил второй,
## упрощённый мозг: своё поле расстояний, свой выбор цели, свой шаг «на одну клетку».
## Он неизбежно отставал от настоящего — не знал ни плана хода, ни дробления движения,
## ни трупов на дороге, — и правки приходилось писать дважды. Двух систем с одной
## задачей быть не должно, поэтому житель теперь просто ИИ с нейтральным владельцем,
## а от этого файла осталось ровно то, что нельзя вывести из владельца одной строкой.

const SOLDIER_OWNERS := [MCF.Owner.PLAYER_1, MCF.Owner.PLAYER_2]

## Житель-НПС: тот, кем НИКТО не командует (#96). Мирным по поведению делает не сама
## профессия, а НЕЙТРАЛЬНАЯ сторона: такого жителя ведёт этот модуль, он враждебен
## всем и в подсчёт армий не входит. Купленный за очки житель встаёт бойцом своей
## стороны — им командует игрок обычными намерениями, и сюда он не попадает.
static func is_npc(u: UnitInstance) -> bool:
	return u != null and u.owner == MCF.Owner.NEUTRAL \
			and u.stats.special_ability_id == MCF.ABILITY_CIVILIAN

## Солдат — живой боец любой из двух игровых сторон. Дрон солдатом не считается:
## это удалённая машина, а не человек на поле. Другой нейтральный житель — тем более:
## своих мирные не трогают.
static func is_soldier(u: UnitInstance) -> bool:
	return u != null and u.is_alive() and not u.is_drone and u.owner in SOLDIER_OWNERS

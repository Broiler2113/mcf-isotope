class_name UnitStats
extends Resource

## Характеристики юнита как данные, а не код (см. §2.4, §6).
## Балансируется правкой ресурса .tres, не логики.

@export var id: String = ""
@export var display_name: String = ""
## Дальность оружия в клетках. inf => бесконечная дальность (лазер Марксманна):
## число попадания всегда 1 (автопопадание). 0 или меньше => оружия нет (стрелять нельзя).
@export var fire_range: float = 12.0
## Штраф к защите цели при стрельбе этого юнита (§таблица характеристик):
## цель парирует только при броске >= (её броня + этот штраф). Снайпер/Щитоносец 2, Шахтёр 1.
@export var target_defense_penalty: int = 0
## Скорострельность — число кубиков на попадание за полное действие стрельбы (§3.5).
@export var rate_of_fire: int = 1
## Класс брони: минимальный бросок d6, чтобы выжить ("4+" => 4).
@export var armor_threshold: int = 4
## Скорость — очки движения за одно действие Движения (§3.1).
@export var speed: int = 6
## Дальность обзора для тумана войны (§3.9). 0 = использовать MCF.DEFAULT_SIGHT_RANGE.
@export var sight_range: int = 0
## Цена юнита в очках баланса (§6, §7). Используется в экране свободной расстановки
## (point-buy): сумма расставленных юнитов не должна превышать бюджет стороны.
@export var cost: int = 1000
## Очков действия за активацию. 0 = стандарт MCF.AP_PER_ACTIVATION (2). Командир
## управляет боем и успевает больше остальных — у него 3 (#66).
@export var action_points: int = 0
## Идентификатор спецспособности (пусто = нет). Реализуется на M2+.
@export var special_ability_id: String = ""
## Стартовый предмет (пусто = нет).
@export var default_item_id: String = ""
@export_multiline var notes: String = ""

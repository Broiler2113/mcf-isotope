class_name GeoField
extends RefCounted

## Геодезическое поле ИИ: сколько шагов по проходимым клеткам до ближайшего источника
## (вражеского бойца или машины). Строит его волновой BFS в AIController, читают —
## планировщик и все генераторы действий.
##
## Раньше поле было обычным Dictionary: Vector2i -> шаги (#106). На карте 60×40 это
## две с половиной тысячи вставок с ключом-вектором на КАЖДЫЙ пересчёт, а пересчётов
## за бой сотни. Хуже того, читают поле в самом горячем месте: выбор хода перебирает
## под две сотни клеток разлива и на каждую спрашивает field.get(coord, GEO_FAR) —
## это сотни тысяч поисков по хешу вектора за партию.
##
## Здесь то же поле лежит ПЛОСКИМ массивом int по индексу y * w + x, а «клетки нет
## в поле» кодируется значением FAR. Тогда чтение — одно индексирование, а постройка
## не делает ни одной вставки в словарь: BFS заполняет массив напрямую и отдаёт его
## готовым в конструктор.
##
## Отдельный словарь _off нужен ровно для одного случая: боец, сидящий в машине,
## вынесен за карту (§техника, coord = OFFBOARD), и прежний код всё равно клал такой
## ключ в поле нулём. Соседей у него нет, волну он не порождает, но has()/at() обязаны
## отвечать про него так же, как отвечал словарь.
const FAR := 1 << 20

var _w: int
var _h: int
var _d: PackedInt32Array
var _off: Dictionary

func _init(p_w: int, p_h: int, p_d: PackedInt32Array, p_off: Dictionary) -> void:
	_w = p_w
	_h = p_h
	_d = p_d
	_off = p_off

## Дотянулась ли волна до клетки (аналог Dictionary.has).
func has(coord: Vector2i) -> bool:
	var x := coord.x
	var y := coord.y
	if x < 0 or y < 0 or x >= _w or y >= _h:
		return _off.has(coord)
	return _d[y * _w + x] != FAR

## Шаги до ближайшего источника; FAR — не дотянулась (аналог Dictionary.get с
## умолчанием GEO_FAR, и значение умолчания то же самое).
func at(coord: Vector2i) -> int:
	var x := coord.x
	var y := coord.y
	if x < 0 or y < 0 or x >= _w or y >= _h:
		return int(_off.get(coord, FAR))
	return _d[y * _w + x]

extends "res://tests/cheats/CheatSuite.gd"

func run() -> void:
	var r := fresh()
	var guest_state := StateCodec.decode(JSON.parse_string(JSON.stringify(StateCodec.encode(r.state))))
	var guest_r := GameActionResolver.new(guest_state)
	var host := NetGame.new(r.state, r, true, 0)
	var guest := NetGame.new(guest_state, guest_r, false, 1)
	host.outgoing.connect(func(msg: Dictionary): var wire: Dictionary = JSON.parse_string(JSON.stringify(msg)); wire._from = 1; guest.receive(wire))
	guest.outgoing.connect(func(msg: Dictionary): var wire: Dictionary = JSON.parse_string(JSON.stringify(msg)); wire._from = 2; host.receive(wire))
	guest.submit_local(CheatIntent.new("unit_ap", {"unit": 1, "value": 7}, 0))
	ck(r.state.get_unit(1).remaining_ap == 7 and guest_state.digest_hash() == r.state.digest_hash(), "authorized guest acts outside their turn; issuer authenticated")
	var parsed := CheatCommands.parse("time evening", guest_state, 1)
	guest.submit_local(CheatIntent.new(parsed.op, parsed.args, 1))
	ck(r.state.time_of_day == "evening" and guest_state.time_of_day == "evening" and guest_state.digest_hash() == r.state.digest_hash(), "authorized time changes synchronize host and guest")
	var before := r.state.digest_hash()
	for peer in [-1, 3]:
		host.receive({"k": NetGame.K_INTENT, "_from": peer, "i": IntentCodec.encode(CheatIntent.new("unit_ap", {"unit": 0, "value": 9}, 0))})
	ck(r.state.digest_hash() == before, "missing and unseated transport identities rejected")
	host.set_cheat_permission(1, false)
	ck(not guest_state.roster.slots[1].cheats_allowed, "revoke propagates immediately")
	host.receive({"k": NetGame.K_INTENT, "_from": 2, "i": IntentCodec.encode(CheatIntent.new("unit_ap", {"unit": 0, "value": 9}, 0))})
	ck(r.state.digest_hash() == before, "forged host issuer cannot bypass revoked peer rights")
	host.receive({"k": NetGame.K_CHEAT_PERMISSIONS, "_from": 2, "slots": [{"side": 1, "allowed": true}]})
	ck(not r.state.roster.slots[1].cheats_allowed, "guest cannot inject permission updates")
	host.set_cheat_permission(1, true)
	guest.submit_local(CheatIntent.new("world_smoke_add", {"x": 5, "y": 5, "width": 3, "height": 2}, 1))
	ck(guest_state.digest_hash() == r.state.digest_hash() and guest_r.random_events.snapshot() == r.random_events.snapshot(), "guest world effects synchronized")
	guest.receive({"k": NetGame.K_CHEAT_PERMISSIONS, "_from": 2, "slots": [{"side": 0, "allowed": false}]})
	ck(guest_state.roster.slots[0].cheats_allowed, "guest rejects non-host permission source")
	host.receive({"k": NetGame.K_RESYNC, "_from": 2})
	ck(guest_state.digest_hash() == r.state.digest_hash(), "resync preserves effects")
	host.match_finished = true
	before = r.state.digest_hash()
	guest.submit_local(CheatIntent.new("unit_ap", {"unit": 1, "value": 9}, 1))
	ck(before == r.state.digest_hash(), "postgame commands denied at authority")
	for connection: Dictionary in host.outgoing.get_connections(): host.outgoing.disconnect(connection.callable)
	for connection: Dictionary in guest.outgoing.get_connections(): guest.outgoing.disconnect(connection.callable)

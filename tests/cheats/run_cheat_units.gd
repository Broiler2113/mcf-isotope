extends "res://tests/cheats/CheatSuite.gd"

func run() -> void:
	var r := fresh()
	var twin := fresh()
	command(r, "spawn unit engineer self 5 5 5")
	command(twin, "spawn unit engineer self 5 5 5")
	ck(r.state.digest_hash() == twin.state.digest_hash(), "expanding ring placement deterministic")
	ck(r.state.all_units().size() == 7, "requested spawn count")
	command(r, "unit item 2 none")
	command(r, "unit ap 2 0")
	command(r, "unit clone 2 10 10 2")
	ck(r.state.get_unit(7).remaining_ap == r.state.get_unit(7).max_ap(), "clone starts with fresh AP")
	ck(r.state.get_unit(7).held_item_id.is_empty(), "clone preserves held item")
	command(r, "unit teleport 2 7 7")
	ck(r.state.grid.cell(Vector2i(7, 7)).occupant == r.state.get_unit(2), "teleport rebinds occupancy")
	rejected(r, "unit teleport 2 2 2")
	command(r, "unit owner 2 #2")
	ck(r.state.get_unit(2).owner == 1, "owner changes")
	command(r, "unit ap 2 refill")
	for field: String in UnitInstance.CHEAT_STAT_BOUNDS:
		command(r, "unit stat 2 %s %d" % [field, UnitInstance.CHEAT_STAT_BOUNDS[field][1]])
	var u := r.state.get_unit(2)
	ck(u.speed() == 999 and u.armor() == 12 and u.fire_range() == 1024 and u.rate_of_fire() == 100 and u.sight() == 1024, "overrides affect actual getters")
	command(r, "unit stat reset 2 speed")
	ck(u.speed() == u.stats.speed, "single stat reset")
	command(r, "unit stat reset 2")
	ck(u.cheat_stats.is_empty(), "all stat reset")
	command(r, "unit invulnerable 2 on")
	var out := ActionResult.success()
	r._kill(u, out)
	r._kill_burnt(u)
	r._gas_survival(u, out)
	r._destroy_cell(u.coord, out)
	r._blast(u.coord, out, MCF.blast_square(u.coord, 1), true, true)
	ck(u.is_alive() and not u.burnt and r.state.deaths.get(1, 0) == 0, "protection covers shared death, burn, gas, barrage and blast")
	ck(r.is_fireproof(u), "protection includes direct and spreading fire")
	ck(not VehicleRules.cell_entry(r.state, u.coord, Vehicle.ID_BASE).ok, "vehicle cannot crush protected occupancy")
	command(r, "unit kill 2")
	ck(not u.is_alive(), "explicit kill bypasses protection")
	command(r, "unit revive 2")
	ck(u.is_alive() and r.state.deaths.get(1, 0) == 0, "revive restores unit and death counter")
	command(r, "unit remove 2")
	ck(r.state.get_unit(2) == null and r.state.grid.cell(Vector2i(7, 7)).occupant == null, "remove clears grid and registry")
	ck(not r.can_undo() and not r.can_redo(), "successful cheats clear history")
	_civilians()
	_damage_paths()

func _civilians() -> void:
	var r := fresh()
	rejected(r, "unit civilian 0 activate")
	command(r, "spawn unit civilian self 6 9")
	command(r, "unit civilian 2 activate")
	ck(r.state.get_unit(2).civilian_active, "civilian activated")
	command(r, "unit civilian 2 sleep")
	ck(not r.state.get_unit(2).civilian_active, "civilian sleeps")
	var neutral := r.state.spawn_unit(load("res://src/data/units/engineer.tres"), Vector2i(12, 5), MCF.Owner.NEUTRAL)
	command(r, "unit civilian %d sleep" % neutral.id)
	command(r, "unit civilian %d activate" % neutral.id)
	ck(neutral.civilian_active and neutral.neutral_group > 0 and r.state.turns.round_order.has(neutral.owner), "neutral of another type joins normal initiative group")
	rejected(r, "unit civilian %d sleep" % neutral.id)

func _damage_paths() -> void:
	for type: String in ["light_infantry", "sniper", "marksman", "flamethrower", "anti_tank"]:
		var r := fresh()
		var attacker := r.state.spawn_unit(load("res://src/data/units/%s.tres" % type), Vector2i(5, 5), 0)
		var target := r.state.spawn_unit(load("res://src/data/units/light_infantry.tres"), Vector2i(7, 5), 1)
		target.cheat_invulnerable = true
		# Guaranteed hits and failed ordinary armor saves; protection must be the reason it survives.
		target.cheat_stats.armor = 12
		var rolls: Array[int] = []
		rolls.resize(256)
		rolls.fill(6)
		r.state.dice.feed_scripted(rolls)
		var res := r.resolve(ShootIntent.new(attacker.id, target.id))
		ck(res.ok, "protected target can be attacked by " + type + ": " + res.reason)
		ck(target.is_alive() and not target.burnt and not res.deaths.has(target.id), "survives " + type + " without false death")
		ck(r.state.deaths.get(1, 0) == 0, "no death counter from " + type)
	var r := fresh()
	var target := r.state.get_unit(0)
	target.cheat_invulnerable = true
	var out := ActionResult.success()
	r.state.grid.cell(target.coord).set_feature(MCF.FEATURE_MINE)
	r._detonate_mine(target.coord, target, out)
	ck(target.is_alive() and r.state.grid.cell(target.coord).feature_id != MCF.FEATURE_MINE, "mine is consumed without killing protected unit")
	r._explode_frag(r.state.get_unit(1), target.coord)
	r._land_collapse({"x": 1, "y": 1, "w": 4, "h": 4}, out)
	ck(target.is_alive(), "direct frag and structural collapse respect protection")
	command(r, "spawn unit drone_operator self 10 10")
	command(r, "world feature set 10 11 drone_station self")
	command(r, "spawn unit drone self 11 11")
	var drone := r.state.get_unit(3)
	drone.cheat_invulnerable = true
	r._land_emp({"x": 11, "y": 11, "w": 1, "h": 1}, out)
	r._drone_explode(drone, drone.coord, "protection test")
	ck(drone.is_alive(), "EMP and drone destruction respect protection")
